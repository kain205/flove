rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userInResource() {
      return signedIn() && request.auth.uid in resource.data.users;
    }

    function userInRequest() {
      return signedIn() && request.auth.uid in request.resource.data.users;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /preferenceProfiles/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /preferenceChats/{userId}/messages/{messageId} {
      allow read, create: if isSelf(userId);
      allow update, delete: if false;
    }

    match /dailyMatchBatches/{batchId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /curatedMatches/{matchId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.candidateId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.candidateId == request.auth.uid);
      allow delete: if false;
    }

    match /matchFeedback/{feedbackId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read, update: if userInResource();
      allow create: if userInRequest();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, update: if userInResource();
      allow create: if userInRequest();
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.users;
        allow update, delete: if false;
      }
    }

    match /blindDateQueue/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId);
      allow update: if signedIn();
      allow delete: if isSelf(userId);
    }

    match /blindDateSessions/{sessionId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
  }
}
