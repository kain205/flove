{
  "name": "flove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm --workspace @flove/app run start",
    "build:app:web": "npm --workspace @flove/app run build:web",
    "build:packages": "npm --workspaces --if-present run build",
    "lint": "eslint .",
    "lint:app": "npm --workspace @flove/app run lint",
    "seed:supabase": "node scripts/seed-supabase-profiles.mjs",
    "supabase:link": "test -n \"$SUPABASE_PROJECT_REF\" || (echo \"Set SUPABASE_PROJECT_REF first\" && exit 1); supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "supabase:db:push": "supabase db push --linked",
    "supabase:db:dry-run": "supabase db push --linked --dry-run",
    "supabase:config:push": "supabase config push",
    "supabase:functions:deploy": "supabase functions deploy --use-api --import-map supabase/functions/deno.json ensure-daily-matches generate-daily-matches analyze-onboarding-profile confirm-onboarding-profile process-ai-jobs submit-match-feedback accept-curated-match send-preference-chat-message ask-conversation-wingman find-blind-date-partner request-reveal",
    "supabase:functions:bundle": "deno bundle --frozen --config supabase/functions/deno.json --platform deno --outdir /tmp/flove-edge-bundles supabase/functions/*/index.ts",
    "supabase:functions:check": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "supabase:functions:test": "deno test --config supabase/functions/deno.json supabase/functions/_shared/*.test.ts supabase/functions/ask-conversation-wingman/*.test.ts supabase/functions/send-preference-chat-message/*.test.ts",
    "supabase:types": "npm run supabase:types:cloud",
    "supabase:types:cloud": "supabase gen types typescript --linked --schema public > packages/supabase/src/database.types.ts",
    "supabase:test": "supabase test db",
    "test": "npm --workspaces --if-present run test",
    "test:e2e:web": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
